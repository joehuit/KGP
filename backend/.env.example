# ==============================================================================
# KGP LIST - Environment Configuration (.env.example)
# Mobile Phone Spare-Parts Catalog & Ordering Platform (Algeria)
# Copy this file to .env before starting the application:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Application Environment: 'development', 'staging', 'production', 'testing'
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="KGP LIST API"
API_V1_STR=/api/v1

# Security & Authentication
# WARNING: Generate a secure 32+ character random string for production
# e.g., using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long
# DEPRECATED: ADMIN_API_KEY is allowed ONLY in development. Disabled in staging/production in favor of JWT Bearer.
ADMIN_API_KEY=dev_admin_api_key_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_MINUTES=43200

# SMS Provider for Customer Phone Verification ('dev_mock', 'twilio', 'algeria_telecom')
# In production, must be set to 'twilio' or 'algeria_telecom' with SMS_API_KEY
SMS_GATEWAY_PROVIDER=dev_mock
SMS_API_KEY=

# CORS Allowed Origins
# Comma-separated list of allowed origins.
# In development, local dev servers are permitted.
# In production, wildcards (*) are strictly rejected by the backend.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kgp_user
POSTGRES_PASSWORD=kgp_secret_password_change_me
POSTGRES_DB=kgp_db

# Complete Database URL (Overwrites individual POSTGRES_* settings if provided)
DATABASE_URL=postgresql+psycopg://kgp_user:kgp_secret_password_change_me@localhost:5432/kgp_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
