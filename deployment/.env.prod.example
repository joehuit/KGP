# ==============================================================================
# Production Environment Configuration Template (.env.prod)
# NEVER commit real production secrets to git.
# ==============================================================================

ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="KGP LIST API"
API_V1_STR=/api/v1

# Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_KEY_OF_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production CORS
# Only specify actual domains; wildcards (*) are forbidden by the application
CORS_ORIGINS=["https://admin.kgp-list.dz","https://app.kgp-list.dz"]

# PostgreSQL Production Credentials
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kgp_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
POSTGRES_DB=kgp_prod_db
DATABASE_URL=postgresql+psycopg://kgp_prod_user:REPLACE_WITH_STRONG_GENERATED_PASSWORD@postgres:5432/kgp_prod_db

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=1800

# Rate Limiting & Logs
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
